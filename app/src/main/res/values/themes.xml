<resources>
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_red</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
    <style name="Theme.MyApplication.Splash" parent="Theme.MyApplication" />
    <style name="Widget.Waves.Input" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/field_background</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/brand_red</item>
        <item name="android:textColorHint">@color/muted_ink</item>
        <item name="startIconTint">@color/muted_ink</item>
        <item name="endIconTint">@color/muted_ink</item>
        <item name="errorTextColor">@color/error_red</item>
    </style>
</resources>
